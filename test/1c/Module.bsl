// Тесты внешней компоненты winFlexCrypto (Vanessa-ADD, xUnit).
//
// Макет «Компонента» — dist\winFlexCrypto.zip (Windows и Linux, x86 и x64).
// Макет «Векторы» — testdata\vectors.json, сформирован эталоном PyNaCl (libsodium):
// совпадение с ним доказывает совместимость компоненты с libsodium и PyNaCl.
// Все проверки выполняются на сервере.

&НаКлиенте
Перем КонтекстЯдра;

&НаКлиенте
Перем Утверждения;

#Область Тесты

&НаКлиенте
Процедура Инициализация(КонтекстЯдраПараметр) Экспорт
	КонтекстЯдра = КонтекстЯдраПараметр;
	Утверждения = КонтекстЯдра.Плагин("БазовыеУтверждения");
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНаборТестов(НаборТестов, КонтекстЯдраПараметр = Неопределено) Экспорт
	НаборТестов.НачатьГруппу("Компонента winFlexCrypto", Ложь);
	НаборТестов.Добавить("ТестДолжен_ПодключитьКомпоненту");
	НаборТестов.Добавить("ТестДолжен_СоздатьКлючи");
	НаборТестов.Добавить("ТестДолжен_ПодписатьКакPyNaCl");
	НаборТестов.Добавить("ТестДолжен_ПодписатьСтрокуКакUTF8");
	НаборТестов.Добавить("ТестДолжен_ПроверитьПодпись");
	НаборТестов.Добавить("ТестДолжен_РасшифроватьКонвертPyNaCl");
	НаборТестов.Добавить("ТестДолжен_ЗашифроватьИРасшифровать");
	НаборТестов.Добавить("ТестДолжен_ЗашифроватьПаролем");
	НаборТестов.Добавить("ТестДолжен_ВычислитьSHA256ИСлучайныеБайты");
	НаборТестов.Добавить("ТестДолжен_СообщитьОбОшибкеПараметров");
КонецПроцедуры

&НаКлиенте
Процедура ТестДолжен_ПодключитьКомпоненту() Экспорт
	КонтекстЯдра.ВывестиСообщение(ПроверкаПодключения());
КонецПроцедуры

&НаКлиенте
Процедура ТестДолжен_СоздатьКлючи() Экспорт
	ПроверкаСозданияКлючей();
КонецПроцедуры

&НаКлиенте
Процедура ТестДолжен_ПодписатьКакPyNaCl() Экспорт
	ПроверкаПодписиPyNaCl();
КонецПроцедуры

&НаКлиенте
Процедура ТестДолжен_ПодписатьСтрокуКакUTF8() Экспорт
	ПроверкаПодписиСтроки();
КонецПроцедуры

&НаКлиенте
Процедура ТестДолжен_ПроверитьПодпись() Экспорт
	ПроверкаПроверкиПодписи();
КонецПроцедуры

&НаКлиенте
Процедура ТестДолжен_РасшифроватьКонвертPyNaCl() Экспорт
	ПроверкаКонвертаPyNaCl();
КонецПроцедуры

&НаКлиенте
Процедура ТестДолжен_ЗашифроватьИРасшифровать() Экспорт
	ПроверкаШифрования();
КонецПроцедуры

&НаКлиенте
Процедура ТестДолжен_ЗашифроватьПаролем() Экспорт
	ПроверкаПароля();
КонецПроцедуры

&НаКлиенте
Процедура ТестДолжен_ВычислитьSHA256ИСлучайныеБайты() Экспорт
	ПроверкаХешаИСлучайныхБайт();
КонецПроцедуры

&НаКлиенте
Процедура ТестДолжен_СообщитьОбОшибкеПараметров() Экспорт
	ПроверкаОшибкиПараметров();
КонецПроцедуры

#КонецОбласти

#Область Проверки

&НаСервере
Функция ПроверкаПодключения()

	Крипто = Компонента();
	Версия = Крипто.Версия();
	Проверить(ЗначениеЗаполнено(Версия), "Версия() пустая");
	// Имена методов — русские и английские, регистр не важен.
	Проверить(Крипто.Version() = Версия, "Version() отличается от Версия()");
	Проверить(Крипто.ВЕРСИЯ() = Версия, "ВЕРСИЯ() отличается от Версия()");

	Сис = Новый СистемнаяИнформация;
	Возврат СтрШаблон("Компонента %1, платформа %2, %3", Версия, Сис.ВерсияПриложения, Сис.ТипПлатформы);

КонецФункции

&НаСервере
Процедура ПроверкаСозданияКлючей()

	Крипто = Компонента();
	КлючиJSON = Крипто.СоздатьКлючи();
	Ключи = ИзJSON(КлючиJSON);
	Для Каждого Имя Из СтрРазделить("sign_secret,sign_public,box_secret,box_public", ",") Цикл
		Проверить(Base64Значение(Ключи[Имя]).Размер() = 32, "длина " + Имя + " не 32 байта");
	КонецЦикла;

	Ключи2 = ИзJSON(Крипто.СоздатьКлючи());
	Проверить(Ключи["sign_secret"] <> Ключи2["sign_secret"], "два набора ключей совпали");

	// Открытая часть — без секретов.
	Открытые = ИзJSON(Крипто.ОткрытыеКлючи(КлючиJSON));
	Проверить(Открытые.Количество() = 2, "ОткрытыеКлючи: ожидается 2 поля, получено " + Открытые.Количество());
	Проверить(Открытые["sign_public"] = Ключи["sign_public"] И Открытые["box_public"] = Ключи["box_public"],
		"ОткрытыеКлючи не совпали с набором");

	Отпечаток = Крипто.Отпечаток(Ключи["sign_public"], Ключи["box_public"]);
	Проверить(СтрДлина(Отпечаток) = 24 И СтрЧислоВхождений(Отпечаток, "-") = 4, "формат отпечатка: " + Отпечаток);

	В = Векторы();
	Проверить(Крипто.Отпечаток(В["keys"]["sign_public"], В["keys"]["box_public"]) = В["fingerprint"],
		"отпечаток не совпал с эталоном");

КонецПроцедуры

&НаСервере
Процедура ПроверкаПодписиPyNaCl()

	Крипто = Компонента();
	В = Векторы();
	Подпись = Крипто.Подписать(Base64Значение(В["data_b64"]), В["keys"]["sign_secret"]);
	Проверить(ТипЗнч(Подпись) = Тип("ДвоичныеДанные"), "подпись не ДвоичныеДанные");
	Проверить(Hex(Подпись) = Hex(Base64Значение(В["signature_b64"])), "подпись не совпала с PyNaCl");

	// Ключ ДвоичнымиДанными и английское имя метода — тот же результат.
	Подпись2 = Крипто.Sign(Base64Значение(В["data_b64"]), Base64Значение(В["keys"]["sign_secret"]));
	Проверить(Hex(Подпись2) = Hex(Подпись), "подпись с ключом ДвоичныеДанные отличается");

КонецПроцедуры

&НаСервере
Процедура ПроверкаПодписиСтроки()

	Крипто = Компонента();
	В = Векторы();
	// Строка подписывается как UTF-8 без BOM — должна дать ту же подпись, что и байты вектора.
	Текст = ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(В["data_b64"]), КодировкаТекста.UTF8);
	Подпись = Крипто.Подписать(Текст, В["keys"]["sign_secret"]);
	Проверить(Hex(Подпись) = Hex(Base64Значение(В["signature_b64"])), "подпись строки не совпала с подписью байт UTF-8");

КонецПроцедуры

&НаСервере
Процедура ПроверкаПроверкиПодписи()

	Крипто = Компонента();
	В = Векторы();
	Данные = Base64Значение(В["data_b64"]);
	Подпись = Base64Значение(В["signature_b64"]);
	Проверить(Крипто.ПроверитьПодпись(Данные, Подпись, В["keys"]["sign_public"]) = Истина, "верная подпись не принята");
	Проверить(Крипто.ПроверитьПодпись(ПолучитьДвоичныеДанныеИзСтроки("другие данные"), Подпись,
		В["keys"]["sign_public"]) = Ложь, "подпись принята для других данных");

	Чужие = ИзJSON(Крипто.СоздатьКлючи());
	Проверить(Крипто.ПроверитьПодпись(Данные, Подпись, Чужие["sign_public"]) = Ложь, "подпись принята чужим ключом");

КонецПроцедуры

&НаСервере
Процедура ПроверкаКонвертаPyNaCl()

	Крипто = Компонента();
	В = Векторы();
	Открытые = Крипто.Расшифровать(Base64Значение(В["sealed_b64"]), В["keys"]["box_secret"]);
	Проверить(Hex(Открытые) = Hex(Base64Значение(В["data_b64"])), "конверт PyNaCl расшифрован неверно");

	// Конверт строкой base64 (как он придёт в JSON) — тоже принимается.
	Открытые2 = Крипто.Расшифровать(В["sealed_b64"], В["keys"]["box_secret"]);
	Проверить(Hex(Открытые2) = Hex(Открытые), "конверт строкой base64 расшифрован иначе");

КонецПроцедуры

&НаСервере
Процедура ПроверкаШифрования()

	Крипто = Компонента();
	Ключи = ИзJSON(Крипто.СоздатьКлючи());
	Данные = ПолучитьДвоичныеДанныеИзСтроки("Секретные данные: " + Строка(Новый УникальныйИдентификатор));

	Конверт = Крипто.ЗашифроватьДля(Данные, Ключи["box_public"]);
	Проверить(Конверт.Размер() = Данные.Размер() + 48, "размер конверта не равен данные + 48");
	Проверить(Hex(Крипто.Расшифровать(Конверт, Ключи["box_secret"])) = Hex(Данные), "данные после расшифровки отличаются");

	// Конверт на тот же ключ каждый раз другой (эфемерный ключ отправителя).
	Проверить(Hex(Крипто.ЗашифроватьДля(Данные, Ключи["box_public"])) <> Hex(Конверт), "два конверта совпали");

	Чужие = ИзJSON(Крипто.СоздатьКлючи());
	Текст = ТекстОшибки(Крипто, "Расшифровать", Конверт, Чужие["box_secret"]);
	Проверить(СтрНайти(Текст, "не удалось расшифровать") > 0, "чужой ключ: " + Текст);

КонецПроцедуры

&НаСервере
Процедура ПроверкаПароля()

	Крипто = Компонента();
	Секрет = "секрет " + Строка(Новый УникальныйИдентификатор);
	Шифр = Крипто.ЗашифроватьПаролем(Секрет, "Пароль-1");
	Проверить(Лев(ПолучитьHexСтрокуИзДвоичныхДанных(Шифр), 8) = "57464331", "заголовок формата не WFC1");
	Проверить(ПолучитьСтрокуИзДвоичныхДанных(Крипто.РасшифроватьПаролем(Шифр, "Пароль-1")) = Секрет,
		"после расшифровки паролем данные отличаются");

	Текст = ТекстОшибки(Крипто, "РасшифроватьПаролем", Шифр, "пароль-1");
	Проверить(СтрНайти(Текст, "неверный пароль") > 0, "неверный пароль: " + Текст);

КонецПроцедуры

&НаСервере
Процедура ПроверкаХешаИСлучайныхБайт()

	Крипто = Компонента();
	В = Векторы();
	Проверить(Hex(Крипто.SHA256(Base64Значение(В["data_b64"]))) = Hex(Base64Значение(В["sha256_b64"])), "SHA256 компоненты");

	// Сверка с платформой.
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(Base64Значение(В["data_b64"]));
	Проверить(Hex(Хеш.ХешСумма) = Hex(Base64Значение(В["sha256_b64"])), "SHA256 платформы");

	Проверить(Крипто.СлучайныеБайты(48).Размер() = 48, "СлучайныеБайты(48)");
	Проверить(Hex(Крипто.СлучайныеБайты(32)) <> Hex(Крипто.СлучайныеБайты(32)), "два вызова СлучайныеБайты совпали");

КонецПроцедуры

&НаСервере
Процедура ПроверкаОшибкиПараметров()

	Крипто = Компонента();
	Текст = ТекстОшибки(Крипто, "Подписать", "данные", "AAAA");
	Проверить(СтрНайти(Текст, "ожидается 32 байт") > 0, "короткий ключ: " + Текст);

	Текст = ТекстОшибки(Крипто, "Подписать", "данные", "не base64 !");
	Проверить(СтрНайти(Текст, "неверный base64") > 0, "не base64: " + Текст);

	Текст = ТекстОшибки(Крипто, "СлучайныеБайты", -1);
	Проверить(СтрНайти(Текст, "неотрицательным") > 0, "отрицательное количество: " + Текст);

	Текст = ТекстОшибки(Крипто, "ОткрытыеКлючи", "{}");
	Проверить(СтрНайти(Текст, "ключевой набор") > 0, "пустой набор ключей: " + Текст);

	// После успешного вызова описание ошибки очищается.
	Крипто.Версия();
	Проверить(Крипто.ОписаниеОшибки = "", "ОписаниеОшибки не очищено: " + Крипто.ОписаниеОшибки);

КонецПроцедуры

#КонецОбласти

#Область Служебные

&НаСервере
Функция Компонента()

	Обработка = РеквизитФормыВЗначение("Объект");
	Адрес = ПоместитьВоВременноеХранилище(Обработка.ПолучитьМакет("Компонента"), УникальныйИдентификатор);
	Если Не ПодключитьВнешнююКомпоненту(Адрес, "winFlex", ТипВнешнейКомпоненты.Native) Тогда
		ВызватьИсключение "Не удалось подключить внешнюю компоненту winFlexCrypto";
	КонецЕсли;
	Возврат Новый("AddIn.winFlex.Crypto");

КонецФункции

&НаСервере
Функция Векторы()

	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат ИзJSON(ПолучитьСтрокуИзДвоичныхДанных(Обработка.ПолучитьМакет("Векторы"), КодировкаТекста.UTF8));

КонецФункции

&НаСервереБезКонтекста
Функция ИзJSON(Текст)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция Hex(Данные)
	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(Данные);
КонецФункции

&НаСервереБезКонтекста
Процедура Проверить(Условие, Описание)
	Если Не Условие Тогда
		ВызватьИсключение "Проверка не пройдена: " + Описание;
	КонецЕсли;
КонецПроцедуры

// Вызвать метод компоненты, который должен завершиться ошибкой, и вернуть текст из ОписаниеОшибки.
&НаСервереБезКонтекста
Функция ТекстОшибки(Крипто, ИмяМетода, П1, П2 = Неопределено)

	Попытка
		Если П2 = Неопределено Тогда
			Выполнить("Крипто." + ИмяМетода + "(П1)");
		Иначе
			Выполнить("Крипто." + ИмяМетода + "(П1, П2)");
		КонецЕсли;
	Исключение
		Возврат Крипто.ОписаниеОшибки;
	КонецПопытки;
	ВызватьИсключение "Метод " + ИмяМетода + " должен был завершиться ошибкой";

КонецФункции

#КонецОбласти
